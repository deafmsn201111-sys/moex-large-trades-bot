# Обязательно
BOT_TOKEN=8799498968:AAEwmpVfSRog12u2_0uEWlSx3z8pECcBydM
TELEGRAM_CHAT_ID=-1003979631185

# Опционально: можно задать тикеры прямо здесь
# Вариант 1: просто список через запятую, тогда будет общий DEFAULT_MIN_VALUE_RUB
# TICKERS=SBER,GAZP,LKOH,YDEX

# Вариант 2: JSON с индивидуальными порогами
# Если задан TICKERS_JSON, он имеет приоритет над config.yaml
# TICKERS_JSON=[{"ticker":"SBER","min_value_rub":10000000},{"ticker":"GAZP","min_value_rub":10000000}]

# Настройки скорости
POLL_SECONDS=1.0
REQUEST_LIMIT=100
CONCURRENCY=5

# Порог по умолчанию в рублях
DEFAULT_MIN_VALUE_RUB=50000

# Если true, при старте бот может прислать последние подходящие сделки из последних N ответов MOEX
# Обычно лучше false, чтобы не спамить историей при перезапуске
SEND_HISTORY_ON_START=false

# Если true, бот пришлёт сообщение о запуске
SEND_START_MESSAGE=false

# Очереди и отправка
ALERT_QUEUE_SIZE=5000
SEND_WORKERS=2

# Путь к конфигу
CONFIG_PATH=config.yaml
# Для Render Web Service PORT обычно задаётся автоматически.
# Локально можно задать самому, если хочешь поднять health endpoint.
# PORT=8000

# URL самого себя для self-ping.
# На Render обычно можно оставить пустым, если RENDER_EXTERNAL_URL доступен.
# Если self-ping не работает, задай вручную:
# SELF_PING_URL=https://your-service-name.onrender.com
SELF_PING_URL=

# Как часто пинговать самого себя в секундах.
SELF_PING_INTERVAL_SECONDS=300
