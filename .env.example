# T-Bank Invest API токен (получить в приложении Т-Банк → Инвестиции → Настройки → API)
TINVEST_TOKEN=t.ВАШ_ТОКЕН

# Telegram
BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=@your_channel

# Настройки бота
DEFAULT_MIN_VALUE_RUB=2000000
SEND_START_MESSAGE=false

# Очередь алертов
ALERT_QUEUE_SIZE=10000
SEND_WORKERS=3

# Self-ping для Render
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=300
